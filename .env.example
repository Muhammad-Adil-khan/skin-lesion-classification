# Copy this file to ".env" (same folder) and edit the values:   cp .env.example .env
# ".env" is listed in .gitignore, so your real values are never uploaded to GitHub.
# docker compose reads ".env" automatically.

# If set, every /api request must send it in the X-API-Key header (the frontend sends it too).
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SKIN_API_KEY=

# How images are resized to the model input: tf_bilinear | pil_bilinear | pil_nearest (must match training)
SKIN_RESIZE_METHOD=tf_bilinear

# Requests per minute per client IP (0 = no limit)
SKIN_RATE_LIMIT_PER_MINUTE=60

# Top probability below this marks a result as "uncertain"
SKIN_MIN_CONFIDENCE=0.5
